{
	"name": "scaffy",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@9.15.9",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"ci": "pnpm install --frozen-lockfile",
		"prepare": "svelte-kit sync || echo '' ; husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:i18n": "node --experimental-strip-types scripts/check-i18n-keys.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"present:diagrams": "node scripts/render-present-diagrams.mjs"
	},
	"lint-staged": {
		"*.{js,ts,mjs,cjs,svelte,css,md,json,yml,yaml}": "prettier --write",
		"*.{js,ts,svelte}": "eslint --fix",
		"src/lib/i18n/translations.ts": "pnpm run check:i18n"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.20.0",
		"@mermaid-js/mermaid-cli": "^11.15.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^24",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7",
		"paneforge": "^1.0.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.94.0",
		"@monaco-editor/loader": "^1.7.0",
		"dompurify": "^3.4.7",
		"marked": "^18.0.4",
		"monaco-editor": "^0.55.1"
	}
}
